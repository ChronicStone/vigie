{
  "name": "@vigiejs/adonis",
  "version": "0.1.0",
  "description": "Send an Adonis app's requests, errors and tasks to Vigie, with one command: node ace add @vigiejs/adonis",
  "license": "MIT",
  "type": "module",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./vigie_provider": "./build/providers/vigie_provider.js",
    "./vigie_middleware": "./build/src/middleware.js",
    "./services/main": "./build/src/services/main.js"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.json && mkdir -p build/stubs/config && cp stubs/config/*.stub build/stubs/config/",
    "prepack": "npm run build"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "telemetry",
    "observability",
    "opentelemetry",
    "wide-events",
    "vigie"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "evlog": "^2.29.0"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.2.0 || ^7.0.0",
    "@adonisjs/otel": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/otel": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/core": "^7.5.2",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChronicStone/vigie.git",
    "directory": "packages/adonis"
  },
  "homepage": "https://vigie-docs.vercel.app"
}
