{
  "name": "@vigiejs/nestjs",
  "version": "0.1.0",
  "description": "Send a NestJS app's requests, errors, traces and background jobs to Vigie, with one command: npx @vigiejs/nestjs init",
  "license": "MIT",
  "type": "module",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "vigie-nestjs": "./build/cli/init.js"
  },
  "exports": {
    ".": "./build/index.js",
    "./register": "./build/src/register.js"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.json && chmod +x build/cli/init.js",
    "test": "node --test test/*.test.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "nestjs",
    "nest",
    "telemetry",
    "observability",
    "opentelemetry",
    "wide-events",
    "vigie"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "evlog": "^2.36.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@types/node": "^24.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChronicStone/vigie.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://vigie.chronicstone.dev",
  "publishConfig": {
    "access": "public"
  }
}
